        "aether_ii:skyroot_lizard": true,
        "productivebees:mason_bee": true,
        "forbidden_arcanus:lost_soul": true,
        "spider_overhaul:cavern_spider": true,
        "productivebees:reed_bee": true,
        "minecraft:strider": true,
        "aether_ii:zephyr": true,
        "minecraft:parrot": true,
        "aether_ii:skephid": true,
        "iceandfire:troll": true,
        "aether_ii:aerbunny": true,
        "aether_ii:carrion_sprout": true,
        "minecraft:zombie_nautilus": true,
        "aether_ii:cockatrice": true,
        "minecraft:bat": true,
        "minecraft:wandering_trader": true,
        "productivebees:sweat_bee": true,
        "minecraft:wither_skeleton": true,
        "productivebees:blue_banded_bee": true,
        "iceandfire:sea_serpent": true,
        "alexsmobs:catfish": true,
        "minecraft:frog": true,
        "minecraft:iron_golem": true,
        "productivebees:nomad_bee": true,
        "minecraft:piglin": true,
        "aether_ii:slider": true,
        "productivebees:ashy_mining_bee": true,
        "minecraft:blaze": true,

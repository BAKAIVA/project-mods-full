        "alexsmobs:raccoon": true,
        "alexsmobs:grizzly_bear": true,
        "minecraft:ravager": true,
        "minecraft:squid": true,
        "aether_ii:highfields_burrukai": true,
        "aether_ii:aechor_plant": true,
        "auroral:auroral_nautilus": true,
        "minecraft:cow": true,
        "minecraft:nautilus": true,
        "aether_ii:glitterwing": true,
        "minecraft:creeper": true,
        "iceandfire:hippocampus": true,
        "minecraft:bee": true,
        "iceandfire:pixie": true,
        "alexsmobs:blue_jay": true,
        "minecraft:salmon": false,
        "productivebees:yellow_black_carpenter_bee": true,
        "minecraft:shulker": true,
        "alexsmobs:frilled_shark": true,
        "minecraft:mooshroom": true,
        "alexsmobs:anteater": true,
        "minecraft:villager": true,

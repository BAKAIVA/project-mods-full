#BlazeGold Coal Generator
[blazegold_coal_generator]
	#Max FE energy storage
	# Default: 2000000
	# Range: > 1
	blazegold_coal_generator_max_fe = 2000000
	#FE transfer every tick
	# Default: 2000
	# Range: > 1
	blazegold_coal_generator_fe_per_tick = 2000
	#FE created per burn tick of fuel
	# Default: 30
	# Range: > 1
	blazegold_coal_generator_fe_per_fuel_tick = 30
	#Multiplier to increase generator speed value
	# Default: 8
	# Range: > 1
	blazegold_coal_generator_burn_speed_multiplier = 8

#Celestigem Coal Generator
[celestigem_coal_generator]
	#Max FE energy storage
	# Default: 3000000
